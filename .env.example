# =====================================================================
# Tree of Life System — Environment Variables Reference
# Copy this file to .env and fill in your values.
# DO NOT commit .env to source control.
# =====================================================================

# Node
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tree-of-life-orchestrator
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_REQUEST_TIMEOUT=30000
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# gRPC Gateway
GRPC_HOST=localhost
GRPC_PORT=50051
GRPC_TLS_ENABLED=false

# Database (optional)
DATABASE_URL=postgresql://localhost/db
MONGODB_URI=mongodb://localhost:27017

# OpenAI (optional — required for AI-powered agents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# GitHub (required for GapAnalyzer)
GITHUB_TOKEN=
GITHUB_OWNER=

# Linear (optional)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Observability
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_SAMPLE_RATE=0.1

# ReWOO Executor
REWOO_MAX_ITERATIONS=3
REWOO_PLANNING_TIMEOUT=30000
REWOO_EXECUTION_TIMEOUT=60000
REWOO_SYNTHESIS_TIMEOUT=30000
